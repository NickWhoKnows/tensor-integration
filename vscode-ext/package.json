{
    "name": "run-app",
    "displayName": "Run App",
    "description": "Run the tllm CMake executable",
    "version": "0.0.1",
    "publisher": "local",
    "engines": {
        "vscode": "^1.85.0"
    },
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "tllm.run",
                "title": "Run App"
            }
        ],
        "menus": {
            "commandPalette": [
                {
                    "command": "tllm.run"
                }
            ]
        }
    },
    "scripts": {
        "compile": "tsc -p ./"
    },
    "devDependencies": {
        "@types/node": "^22.20.1",
        "@types/vscode": "^1.85.0",
        "typescript": "^5.0.0"
    }
}
